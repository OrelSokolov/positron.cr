.crystal/
*.tar.gz
/lib/
/.shards/
*.dwarf
/.env

# Example binaries (everything inside an example dir except source and frontend)
/examples/*/**
!/examples/*/*.cr
!/examples/*/frontend/
!/examples/*/frontend/**

# Build logs
/logs/*.log

# crosspack build output tree
/builds/

# Compiled binaries (positron CLI, staged example binaries)
/bin/

# crosspack pack output and staging
/crosspacks/
/build/

# Android build artifacts (keep sources: manifest, shim, activity, script)
/android/build/
/android/apk/
/android/res/
/android/*.apk
/android/*.idsig
/android/debug.keystore
